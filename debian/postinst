#!/bin/sh
set -e

if ! getent group silkworm-operators >/dev/null; then
  addgroup --system silkworm-operators >/dev/null
fi

if [ -d /usr/share/silkworm-observer/updater.json.example ]; then
  rm -rf /usr/share/silkworm-observer/updater.json.example
fi

if [ -f /usr/lib/systemd/system/silkworm-updater.service ]; then
  rm -f /usr/lib/systemd/system/silkworm-updater.service
fi

if [ ! -f /etc/silkworm-observer/updater.json ]; then
  mkdir -p /etc/silkworm-observer
  cp /usr/share/silkworm-observer/updater.json.example /etc/silkworm-observer/updater.json || true
fi

if [ -f /etc/silkworm-observer/updater.json ]; then
  chmod 644 /etc/silkworm-observer/updater.json || true
fi

systemctl daemon-reload || true
systemctl enable --now silkworm-updater.service || true

exit 0
